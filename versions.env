# Single source of truth for all pinned versions.
# Sourced by scripts/*.sh, the Makefile and CI. Change a version here only.

# --- Node / Kubernetes ------------------------------------------------------
K8S_MINOR=v1.36
K8S_VERSION=1.36.5               # kubeadm / kubelet / kubectl (pkgs.k8s.io)
K8S_PKG_REVISION=1.1             # deb revision -> 1.36.5-1.1
CONTAINERD_VERSION=2.2.9
RUNC_VERSION=1.4.3
HELM_VERSION=4.3.0

# --- Cluster add-ons (Helm charts) --------------------------------------------
CALICO_VERSION=v3.33.0                    # tigera-operator chart
LOCAL_PATH_PROVISIONER_VERSION=v0.0.37    # vendored: deploy/storage/
METRICS_SERVER_CHART_VERSION=3.14.0       # app 0.9.0
CERT_MANAGER_VERSION=v1.21.2
ENVOY_GATEWAY_VERSION=v1.9.2              # Gateway API v1.6.1 bundled
KUBE_PROMETHEUS_STACK_VERSION=91.8.2      # prometheus-operator v0.94.1
VICTORIA_LOGS_CHART_VERSION=0.13.10       # VictoriaLogs v1.53.0
FLUENTD_CHART_VERSION=0.6.0               # Fluentd v1.19.3

# --- Network -----------------------------------------------------------------
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12
GATEWAY_HTTP_NODEPORT=30080
GATEWAY_HTTPS_NODEPORT=30443
DEMO_DOMAIN=demo.local
